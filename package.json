{
  "name": "@anthonyhan/token-pilot",
  "version": "0.4.0",
  "description": "你所有 AI 工具的本地账单 + 预算控制器 — 只读本地日志，零入侵，不出本机",
  "type": "module",
  "bin": {
    "token-pilot": "./bin/token-pilot.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "sync:assets": "node scripts/sync-web-assets.js",
    "verify:assets": "node scripts/sync-web-assets.js --check",
    "today": "npx tsx src/cli/index.ts today",
    "test": "npx tsx --test tests/*.test.ts",
    "prepublishOnly": "npm run build",
    "metrics": "python3 scripts/publish-metrics.py",
    "metrics:report": "python3 scripts/publish-metrics.py --report"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "files": [
    "dist",
    "pricing",
    "bin",
    "web"
  ]
}
