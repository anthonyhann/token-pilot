{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "token-pilot",
  "version": "0.3.0",
  "identifier": "com.anthonyhann.tokenpilot",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Token Pilot",
        "width": 480,
        "height": 760,
        "resizable": true,
        "minWidth": 400,
        "minHeight": 520,
        "maxWidth": 720,
        "alwaysOnTop": true,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "skipTaskbar": true
      },
      {
        "label": "dashboard",
        "title": "Token Pilot · 本地看板",
        "url": "dashboard.html",
        "width": 1500,
        "height": 950,
        "minWidth": 1040,
        "minHeight": 640,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "active": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIwOTMxRjkyRTM2Q0VDMkMKUldRczdHempraCtUc1BHT3BINEd1eGc0VnpPNmJIVi9BakNja2M0cElsME1rNUN6bUlsRU9qTmMK",
      "endpoints": [
        "https://github.com/anthonyhann/token-pilot/releases/latest/download/latest.json"
      ]
    }
  }
}