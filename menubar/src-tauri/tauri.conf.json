{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "token-pilot",
  "version": "0.1.0",
  "identifier": "com.anthonyhann.tokenpilot",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "frontendDist": "../src",
    "devUrl": "http://127.0.0.1:8765"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Token Pilot",
        "width": 400,
        "height": 720,
        "resizable": false,
        "alwaysOnTop": true,
        "decorations": false,
        "visible": false,
        "skipTaskbar": true
      },
      {
        "label": "dashboard",
        "title": "Token Pilot · 本地看板",
        "url": "dashboard.html",
        "width": 1320,
        "height": 900,
        "minWidth": 1040,
        "minHeight": 640,
        "resizable": true,
        "visible": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
